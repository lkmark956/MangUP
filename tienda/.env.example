# ===================================
# MANGUP - CONFIGURACIÓN DE APLICACIÓN
# ===================================

APP_NAME=MangUP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ===================================
# CONFIGURACIÓN DE BASE DE DATOS
# ===================================
# 1. Crea la base de datos en MySQL: CREATE DATABASE mangup_db;
# 2. Configura aquí tu usuario y contraseña de MySQL
# 3. Ejecuta: php artisan migrate --seed

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mangup_db
DB_USERNAME=root
DB_PASSWORD=

# ===================================
# CONFIGURACIÓN DE SESIÓN
# ===================================

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ===================================
# STRIPE - PASARELA DE PAGO
# ===================================
# ⚠️ IMPORTANTE: Debes configurar tus propias claves de Stripe
# 
# Cómo obtener las claves:
# 1. Regístrate gratis en: https://stripe.com
# 2. Ve a: https://dashboard.stripe.com/test/apikeys
# 3. Asegúrate de estar en modo "Test" (interruptor arriba a la izquierda)
# 4. Copia la "Publishable key" (empieza con pk_test_...)
# 5. Copia la "Secret key" (empieza con sk_test_...) - clic en "Reveal"
#
# ✅ Validaciones:
# - STRIPE_KEY debe empezar con: pk_test_ (test) o pk_live_ (producción)
# - STRIPE_SECRET debe empezar con: sk_test_ (test) o sk_live_ (producción)
# - No dejes espacios al inicio o final de las claves
# - Nunca subas tus claves reales a GitHub
#
# 💳 Tarjeta de prueba para testing:
# - Número: 4242 4242 4242 4242
# - Fecha: Cualquier fecha futura (ej: 12/34)
# - CVV: Cualquier 3 dígitos (ej: 123)

STRIPE_KEY=pk_test_YourPublishableKeyHere
STRIPE_SECRET=sk_test_YourSecretKeyHere
STRIPE_WEBHOOK_SECRET=

# ===================================
# VITE (Compilación de Assets)
# ===================================

VITE_APP_NAME="${APP_NAME}"
